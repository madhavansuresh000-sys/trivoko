    {
      "name": "7. Accounts & roles (Phase 2)",
      "item": [
        {
          "name": "Get the CSRF cookie",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/csrf"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));",
                  "pm.test('XSRF-TOKEN cookie saved', () => { const t = pm.cookies.get('XSRF-TOKEN'); pm.expect(t).to.be.a('string'); pm.collectionVariables.set('xsrf', t); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as kovai.sports",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kovai.sports@trivoko.test\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"it is kovai.sports\", () => { const j = pm.response.json(); pm.expect(j.email).to.eql('kovai.sports@trivoko.test'); });",
                  "pm.test(\"a seller\", () => { const j = pm.response.json(); pm.expect(j.roles).to.include('SELLER'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I (Kovai Sports)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"my shop is approved\", () => { const j = pm.response.json(); pm.expect(j.seller.slug).to.eql('kovai-sports'); pm.expect(j.seller.status).to.eql('APPROVED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create a product (DRAFT)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/seller/products",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Newman Practice Cricket Ball\",\n  \"categoryId\": \"{{cricketCategory}}\",\n  \"brand\": \"Kovai\",\n  \"description\": \"Made by the Postman checks; the admin rejects it, so it never goes live.\",\n  \"variants\": [\n    {\n      \"label\": \"Red leather\",\n      \"colour\": \"Red\",\n      \"price\": 799,\n      \"mrp\": 999,\n      \"stock\": 10\n    },\n    {\n      \"label\": \"White leather\",\n      \"colour\": \"White\",\n      \"price\": 899,\n      \"mrp\": 1099,\n      \"stock\": 6\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test(\"DRAFT with the cheapest price\", () => { const j = pm.response.json(); pm.expect(j.status).to.eql('DRAFT'); pm.expect(j.priceFrom).to.eql(799); });",
                  "pm.collectionVariables.set('productId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit it for approval",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/seller/products/{{productId}}/submit",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"PENDING\", () => { const j = pm.response.json(); pm.expect(j.status).to.eql('PENDING'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@trivoko.test\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"it is admin\", () => { const j = pm.response.json(); pm.expect(j.email).to.eql('admin@trivoko.test'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin rejects it (keeps the shop counts unchanged)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/products/{{productId}}/reject",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Practice product from the Postman checks\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"REJECTED with the reason\", () => { const j = pm.response.json(); pm.expect(j.status).to.eql('REJECTED'); pm.expect(j.rejectionReason).to.eql('Practice product from the Postman checks'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as chennai.mobiles",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{xsrf}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
