{
  "info": {
    "name": "TriVoKo API (Phase 1-3)",
    "description": "The public catalogue, accounts & roles, search and the cart, with automatic checks. Needs the backend on localhost:8080 with the Flyway sample data (V2-V4) and the demo password in the demoPassword variable (DEMO_PASSWORD from .env). Generated by tools/postman-gen/make_collection.py.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "demoPassword",
      "value": ""
    },
    {
      "key": "cricketCategory",
      "value": "26"
    },
    {
      "key": "xsrf",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "chennaiVariant",
      "value": ""
    },
    {
      "key": "kovaiVariant",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Backend is UP",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"status is UP\", () => { const j = pm.response.json(); pm.expect(j.status).to.eql('UP'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Categories",
