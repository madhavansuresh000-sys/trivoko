            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"chennai.mobiles@trivoko.test\",\n  \"password\": \"{{demoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
