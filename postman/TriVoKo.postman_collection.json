{
  "info": {
    "name": "TriVoKo API (Phase 1)",
    "description": "The public catalogue with automatic checks. Needs the backend on localhost:8080 with the Flyway sample data (V2). Generated by tools/postman-gen/make_collection.py.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Backend is UP",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"status is UP\", () => { const j = pm.response.json(); pm.expect(j.status).to.eql('UP'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Categories",
      "item": [
        {
          "name": "Category tree",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"10 top categories\", () => { const j = pm.response.json(); pm.expect(j).to.have.length(10); });",
                  "pm.test(\"first is Mobiles & Accessories with 3 children\", () => { const j = pm.response.json(); pm.expect(j[0].name).to.eql('Mobiles & Accessories'); pm.expect(j[0].children).to.have.length(3); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Product listing",
      "item": [
        {
          "name": "DONE-WHEN: phones by price, page 0",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?category=phones&sort=price&size=2"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"4 phones in 2 pages\", () => { const j = pm.response.json(); pm.expect(j.totalElements).to.eql(4); pm.expect(j.totalPages).to.eql(2); });",
                  "pm.test(\"cheapest first\", () => { const j = pm.response.json(); pm.expect(j.content.map(p => p.name)).to.eql(['Kaveri K5', 'Volta V12 5G']); });"
                ]
              }
            }
          ]
        },
        {
          "name": "DONE-WHEN: phones by price, page 1",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?category=phones&sort=price&size=2&page=1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"next two, last page\", () => { const j = pm.response.json(); pm.expect(j.content.map(p => p.name)).to.eql(['Nimbus N8 Pro', 'Orbit X Ultra']); pm.expect(j.last).to.be.true; });"
                ]
              }
            }
          ]
        },
        {
          "name": "All live products (newest first)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"116 live products (3 pending + 1 rejected hidden)\", () => { const j = pm.response.json(); pm.expect(j.totalElements).to.eql(116); });",
                  "pm.test(\"24 per page by default\", () => { const j = pm.response.json(); pm.expect(j.size).to.eql(24); pm.expect(j.content).to.have.length(24); });",
                  "pm.test(\"newest first\", () => { const j = pm.response.json(); pm.expect(j.content[0].name).to.eql('PlayBox lunch bag'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Top category includes its sub-categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?category=mobiles-accessories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"12 products\", () => { const j = pm.response.json(); pm.expect(j.totalElements).to.eql(12); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Brand filter",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?brand=Arc&size=48"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"11 live Arc products\", () => { const j = pm.response.json(); pm.expect(j.totalElements).to.eql(11); });",
                  "pm.test(\"all Arc\", () => { const j = pm.response.json(); j.content.forEach(p => pm.expect(p.brand).to.eql('Arc')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Price range 500-1000",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?minPrice=500&maxPrice=1000&size=48"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"every price inside the range\", () => { const j = pm.response.json(); pm.expect(j.totalElements).to.be.above(0); j.content.forEach(p => pm.expect(p.priceFrom).to.be.within(500, 1000)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "In stock only (cycling)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?category=cycling&inStock=true"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"sold-out lights hidden\", () => { const j = pm.response.json(); pm.expect(j.totalElements).to.eql(2); pm.expect(j.content.map(p => p.slug)).to.not.include('velo-bicycle-lights-set'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Shop filter (Pondy Books)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?seller=pondy-books"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"12 books\", () => { const j = pm.response.json(); pm.expect(j.totalElements).to.eql(12); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Most expensive first",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?sort=price&dir=desc"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"Zentra Pro 16 first\", () => { const j = pm.response.json(); pm.expect(j.content[0].name).to.eql('Zentra Pro 16'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Page size is capped at 48",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?size=500"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"size 48\", () => { const j = pm.response.json(); pm.expect(j.size).to.eql(48); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown sort -> 400",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?sort=popular"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "minPrice > maxPrice -> 400",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?minPrice=1000&maxPrice=500"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown category -> 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?category=spaceships"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Product page",
      "item": [
        {
          "name": "iPhone 15 case (Ravi's order)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/silicone-case-for-iphone-15"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"3 colours\", () => { const j = pm.response.json(); pm.expect(j.variants).to.have.length(3); });",
                  "pm.test(\"sold by Chennai Mobiles\", () => { const j = pm.response.json(); pm.expect(j.seller.slug).to.eql('chennai-mobiles'); });",
                  "pm.test(\"breadcrumb\", () => { const j = pm.response.json(); pm.expect(j.category.slug).to.eql('cases-covers'); pm.expect(j.category.parent.slug).to.eql('mobiles-accessories'); });",
                  "pm.test(\"exact stock is never sent\", () => { const j = pm.response.json(); j.variants.forEach(v => pm.expect(v).to.not.have.property('stock')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Low stock shows 'only 3 left'",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/salem-steel-idli-maker"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"onlyLeft = 3\", () => { const j = pm.response.json(); pm.expect(j.variants[0].onlyLeft).to.eql(3); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Pending product -> 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/arc-soundbar-2-1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Shop page",
      "item": [
        {
          "name": "Chennai Mobiles",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sellers/chennai-mobiles"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test(\"shop name and city\", () => { const j = pm.response.json(); pm.expect(j.shopName).to.eql('Chennai Mobiles'); pm.expect(j.city).to.eql('Chennai'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Pending shop -> 404",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sellers/erode-organics"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Uploads",
      "item": [
        {
          "name": "Signature from a stranger -> 403",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/uploads/signature"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
