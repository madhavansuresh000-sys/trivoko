# Copy this file to .env and choose your own passwords.
# .env is in .gitignore, so your real passwords never go to GitHub.
MYSQL_USER=trivoko
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Phase 1: product photos. Free account at cloudinary.com -> Dashboard shows these 3 values.
# Leave empty and the upload URL answers 503 "not set up yet" (everything else still works).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Later phases add more keys here:
#   Phase 2: JWT_SECRET, DEMO_PASSWORD
#   Phase 4: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET
