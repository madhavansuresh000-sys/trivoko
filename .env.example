# Copy this file to .env and choose your own passwords.
# .env is in .gitignore, so your real passwords never go to GitHub.
MYSQL_USER=trivoko
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# Phase 1: product photos. Free account at cloudinary.com -> Dashboard shows these 3 values.
# Leave empty and the upload URL answers 503 "not set up yet" (everything else still works).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 2: login. JWT_SECRET signs the login cookie - at least 32 random characters, keep it private.
# DEMO_PASSWORD = the password of the demo accounts (admin@trivoko.test, ravi@trivoko.test,
# kovai.sports@trivoko.test ...). Empty = the demo accounts stay locked.
JWT_SECRET=
DEMO_PASSWORD=

# Phase 4: payments. Empty = the built-in TEST payment page (no real money, no account needed).
# With a free Stripe TEST account (dashboard.stripe.com, "Test mode" on): Developers -> API keys -> sk_test_...
# The webhook secret (whsec_...) is printed by the Stripe CLI:
#   stripe listen --forward-to localhost:8080/api/payments/stripe/webhook
# Never put an sk_live_ key here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Phase 4: emails go to Mailpit in dev (http://localhost:8026). MAIL_ENABLED=false = bell only.
MAIL_ENABLED=true
